<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bookingRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="?attr/colorSurface"> <!-- Correct dynamic background -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ожидаем водителя..."
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:textColor="?attr/colorOnSurface"/> <!-- Correct dynamic text color -->

    <Button
        android:id="@+id/cancelWaiting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Отменить заказ"
        android:backgroundTint="?attr/colorError"
        android:textColor="?attr/colorOnError"/> <!-- Correct contrast color for error -->
</LinearLayout>


